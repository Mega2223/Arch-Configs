{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,

    "modules-left": [
        "hyprland/workspaces",
	"mpris",
	"playerctl"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/work_clock",
        "tray",
        "cpu_text",
        "cpu",
        "memory",
        "battery",
        "network",
        "pulseaudio"
	
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "format": "{:%a %d, %H:%M}",
        "tooltip": false 
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,

        "states": {
            "critical": 90
        }
    },

    "memory": {
        "format": "MEM {percentage}%",
        "interval": 2,

        "states": {
            "critical": 80
        }
    },

    "battery": {
        "format": "BAT {capacity}%",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10,
	    "urgent": 5
        },
        "tooltip": false
    },

    "network": {
        "format-wifi" : "WIFI",
        "format-ethernet": "ETHER",
        "format-disconnected" : "NO-CON",
        "tooltip": false,
	"on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "VOL {volume}%",
        "format-bluetooth": "VOL {volume}%",
        "nospacing": 1,
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "mpris": {
	    "format": "{player_icon} {title} [{position}/{length}]",
	    "format-paused": "{status_icon}",
	    "player-icons": {
	        "default": " >"
		    //"mpv": "🎵 ",
		    //"max-length": 15
	    },
	    "status-icons": {
		    //"paused": "⏸"
		    "paused": " > [PS]"
	    },
	    "title-len":30,
        "interval": 1
	    //"max-length":30
	},

    "custom/work_clock":{
        "format": "{} ",
        //"exec-if": "expr $(date +%u) '<' 5 \\& $(date +%H) '<' 19 >> /dev/null", // dias da semana
        "exec": "work_clock 12:00 18:30 --once --end_empty --empty-before"//,
        //"interval": 1
    }
}
