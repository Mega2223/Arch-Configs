{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,

    "modules-left": [
        "hyprland/workspaces",
	"mpris",
	"playerctl"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "cpu_text",
        "cpu",
        "memory",
        "battery",
        "network",
        "pulseaudio"
	
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "format": "{:%a %d, %H:%M}",
        "tooltip": false 
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,

        "states": {
            "critical": 90
        }
    },

    "memory": {
        "format": "MEM {percentage}%",
        "interval": 2,

        "states": {
            "critical": 80
        }
    },

    "battery": {
        "format": "BAT {capacity}%",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10,
	    "urgent": 5
        },
        "tooltip": false
    },

    "network": {
        "format-wifi" : "WIFI",
        "format-ethernet": "ETHER",
        "format-disconnected" : "NO-CON",
        "tooltip": false
    },

    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "VOL {volume}%",
        "format-bluetooth": "VOL {volume}%",
        "nospacing": 1,
        "on-click": "pavucontrol",
        "tooltip": false
    },

"mpris": {
	"format": "{player_icon} {title} [{length}]",
	"format-paused": "{status_icon}",
	"player-icons": {
		"default": " >",
		"mpv": "🎵"
	},
	"status-icons": {
		//"paused": "⏸"
		"paused": "[PS]"
	}
	}
}
